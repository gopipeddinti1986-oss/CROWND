# ==============================================================================
# CROWND — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your project credentials.
# NEVER commit .env.local or expose secret keys in client-side code!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Credentials (Safe for Browser & Server)
# ------------------------------------------------------------------------------
# The unique project URL provided in your Supabase dashboard.
# Find it at: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public anonymous API key (publicly safe, scoped by Row Level Security policies).
# Find it at: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' / 'public'
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server-Only Secret Credentials (CRITICAL: NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# The service role key bypasses Row Level Security.
# Strictly use only in secure server-side environments (Server Actions, Route Handlers, Migrations).
# Find it at: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'service_role' (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Application Configuration
# ------------------------------------------------------------------------------
# Base URL of the application. Used for absolute URLs, metadata, email callbacks, and sitemaps.
# Development: http://localhost:3000
# Production: https://crownd.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
